{
  "manifest_version": 2,
  "name": "Material You Thunderbird",
  "description": "Thème moderne Material You (Material Design 3) pour Mozilla Thunderbird avec palettes tonales dynamiques, pilules et élévations soignées.",
  "version": "1.1.2",
  "author": "Vincent Foriel",
  "homepage_url": "https://vforiel.github.io/Material-Thunderbird/",
  "applications": {
    "gecko": {
      "id": "material-you-thunderbird@vforiel",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "64": "icons/icon.svg"
  },
  "permissions": [
    "messagesRead",
    "messageDisplayScripts",
    "scripting",
    "tabs"
  ],
  "background": {
    "scripts": [
      "shared/unsubscribe-rules.js",
      "background.js"
    ]
  },
  "experiment_apis": {
    "materialAssistant": {
      "schema": "experiments/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "events": [
          "startup"
        ],
        "paths": [
          [
            "materialAssistant"
          ]
        ],
        "script": "experiments/material-assistant.js"
      }
    }
  }
}

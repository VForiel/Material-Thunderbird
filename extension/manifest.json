{
  "manifest_version": 2,
  "name": "Material You Thunderbird",
  "description": "Thème moderne Material You (Material Design 3) pour Mozilla Thunderbird avec palettes tonales dynamiques, pilules et élévations soignées.",
  "version": "1.0.0",
  "author": "VForiel",
  "homepage_url": "https://github.com/VForiel/Material-Thunderbird",
  "applications": {
    "gecko": {
      "id": "material-you-thunderbird@vforiel",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "64": "icons/icon.svg"
  },
  "permissions": [
    "messagesRead",
    "messageDisplayScripts",
    "tabs"
  ],
  "background": {
    "scripts": [
      "shared/unsubscribe-rules.js",
      "background.js"
    ]
  },
  "experiment_apis": {
    "materialAssistant": {
      "schema": "experiments/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["materialAssistant"]],
        "script": "experiments/material-assistant.js"
      }
    }
  },
  "theme_experiment": {
    "stylesheet": "material-theme.css",
    "colors": {
      "exp_primary": "--md-primary",
      "exp_surface": "--md-surface"
    }
  },
  "theme": {
    "colors": {
      "frame": "#f0f4fa",
      "frame_inactive": "#edf2fa",
      "tab_selected": "#FFFFFF",
      "tab_text": "#0B57D0",
      "tab_background_text": "#444746",
      "tab_line": "#0B57D0",
      "toolbar": "#edf2fa",
      "toolbar_text": "#1F1F1F",
      "toolbar_field": "#e2e8f0",
      "toolbar_field_text": "#1F1F1F",
      "toolbar_field_border": "transparent",
      "toolbar_top_separator": "transparent",
      "toolbar_bottom_separator": "#C4C7C5",
      "icons": "#444746",
      "icons_attention": "#0B57D0",
      "popup": "#dbe3f0",
      "popup_text": "#1F1F1F",
      "popup_border": "#C4C7C5",
      "popup_highlight": "#c2e7ff",
      "popup_highlight_text": "#001d35",
      "sidebar": "#edf2fa",
      "sidebar_text": "#1F1F1F",
      "sidebar_highlight": "#c2e7ff",
      "sidebar_highlight_text": "#001d35",
      "button_background_hover": "rgba(11, 87, 208, 0.08)",
      "button_background_active": "rgba(11, 87, 208, 0.16)"
    }
  },
  "dark_theme": {
    "colors": {
      "frame": "#111315",
      "frame_inactive": "#191c1e",
      "tab_selected": "#272a2d",
      "tab_text": "#A8C7FA",
      "tab_background_text": "#C4C7C5",
      "tab_line": "#A8C7FA",
      "toolbar": "#191C1E",
      "toolbar_text": "#E2E2E5",
      "toolbar_field": "#1d2023",
      "toolbar_field_text": "#E2E2E5",
      "toolbar_field_border": "transparent",
      "toolbar_top_separator": "transparent",
      "toolbar_bottom_separator": "#444746",
      "icons": "#C4C7C5",
      "icons_attention": "#A8C7FA",
      "popup": "#272a2d",
      "popup_text": "#E2E2E5",
      "popup_border": "#444746",
      "popup_highlight": "#004B72",
      "popup_highlight_text": "#C7E7FF",
      "sidebar": "#191C1E",
      "sidebar_text": "#E2E2E5",
      "sidebar_highlight": "#004B72",
      "sidebar_highlight_text": "#C7E7FF",
      "button_background_hover": "rgba(168, 199, 250, 0.08)",
      "button_background_active": "rgba(168, 199, 250, 0.16)"
    }
  }
}
